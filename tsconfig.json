{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Lets tsdown emit .d.ts files with oxc instead of the experimental TypeScript 7 API.
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true
  },
  "include": ["src"]
}
