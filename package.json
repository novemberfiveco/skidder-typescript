{
  "name": "@novemberfiveco/skidder-typescript",
  "version": "1.1.0",
  "description": "November Five's logging library. Skidder will drag your logs where they need to go.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novemberfiveco/skidder-typescript.git"
  },
  "author": "Jens Reynders <jens.reynders@novemberfive.co>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "commit": "git add . && npx git-cz --disable-emoji",
    "prepack": "npm run build",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^5.1.1",
    "release-it": "^15.9.3",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true,
      "autoGenerate": true,
      "tokenRef": "GITHUB_TOKEN"
    },
    "npm": {
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance improvements"
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "ignoreRecommendedBump": true
      }
    }
  }
}
